# Firebase Web SDK configuration (public project identifiers, not server secrets).
# Copy to apps/web/.env.local and use only values from your Firebase Emulator/local project.
NEXT_PUBLIC_FIREBASE_API_KEY=replace-with-local-firebase-web-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=localhost
NEXT_PUBLIC_FIREBASE_PROJECT_ID=demo-resolvtec
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=demo-resolvtec.appspot.com
NEXT_PUBLIC_FIREBASE_APP_ID=replace-with-local-firebase-app-id
NEXT_PUBLIC_USE_FIREBASE_EMULATORS=true

# Local emulator seed only. Keep the actual password in your shell environment; do not commit it.
RESOLVTEC_SEED_ADMIN_EMAIL=admin@resolvtec.local
# Set RESOLVTEC_SEED_ADMIN_PASSWORD in the local shell before running the seed command.
